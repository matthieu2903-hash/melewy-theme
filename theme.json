{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1232px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        {
          "slug": "fond",
          "name": "Fond",
          "color": "#EEF1F6"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#FFFFFF"
        },
        {
          "slug": "encre",
          "name": "Encre",
          "color": "#12141C"
        },
        {
          "slug": "texte-doux",
          "name": "Texte doux",
          "color": "#4A4F5E"
        },
        {
          "slug": "trait",
          "name": "Trait",
          "color": "#E1E5EC"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#5B3DF5"
        },
        {
          "slug": "citron",
          "name": "Citron",
          "color": "#D6FF5C"
        },
        {
          "slug": "marketing",
          "name": "Marketing",
          "color": "#FFD9C9"
        },
        {
          "slug": "communication",
          "name": "Communication",
          "color": "#CFE3FF"
        },
        {
          "slug": "creation",
          "name": "Création graphique",
          "color": "#D9F2D0"
        },
        {
          "slug": "gestion",
          "name": "Gestion de projet",
          "color": "#E6DDFF"
        },
        {
          "slug": "universitaire",
          "name": "Travaux universitaires",
          "color": "#FFF1C2"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "jakarta",
          "name": "Plus Jakarta Sans",
          "fontFamily": "\"Plus Jakarta Sans\", system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Plus Jakarta Sans",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/plus-jakarta-sans-latin.woff2"
              ],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Plus Jakarta Sans",
              "fontStyle": "normal",
              "fontWeight": "200 800",
              "fontDisplay": "swap",
              "src": [
                "file:./assets/fonts/plus-jakarta-sans-latin-ext.woff2"
              ],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Petit",
          "size": "0.9375rem"
        },
        {
          "slug": "medium",
          "name": "Normal",
          "size": "1rem"
        },
        {
          "slug": "large",
          "name": "Chapeau",
          "size": "1.1875rem"
        },
        {
          "slug": "x-large",
          "name": "Titre de tuile",
          "size": "1.75rem"
        },
        {
          "slug": "xx-large",
          "name": "Titre de section",
          "size": "clamp(1.75rem, 3vw, 2.25rem)"
        },
        {
          "slug": "huge",
          "name": "Titre principal",
          "size": "clamp(2.5rem, 6vw, 4.75rem)"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "10",
          "name": "XS",
          "size": "8px"
        },
        {
          "slug": "20",
          "name": "S",
          "size": "16px"
        },
        {
          "slug": "30",
          "name": "M",
          "size": "24px"
        },
        {
          "slug": "40",
          "name": "L",
          "size": "clamp(24px, 3.5vw, 36px)"
        },
        {
          "slug": "50",
          "name": "XL",
          "size": "clamp(28px, 4.5vw, 48px)"
        }
      ]
    },
    "custom": {
      "rayon": {
        "tuile": "28px",
        "pilule": "999px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--fond)",
      "text": "var(--wp--preset--color--encre)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--jakarta)",
      "fontSize": "var(--wp--preset--font-size--medium)",
      "lineHeight": "1.55"
    },
    "spacing": {
      "blockGap": "16px",
      "padding": {
        "top": "24px",
        "bottom": "48px",
        "left": "clamp(16px, 3vw, 24px)",
        "right": "clamp(16px, 3vw, 24px)"
      }
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--encre)"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--accent)"
          }
        }
      },
      "heading": {
        "typography": {
          "fontWeight": "800",
          "lineHeight": "1.1",
          "letterSpacing": "-0.02em"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--huge)",
          "lineHeight": "1",
          "letterSpacing": "-0.035em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xx-large)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--encre)",
          "text": "var(--wp--preset--color--surface)"
        },
        "border": {
          "radius": "999px"
        },
        "spacing": {
          "padding": {
            "top": "14px",
            "bottom": "14px",
            "left": "24px",
            "right": "24px"
          }
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "var(--wp--preset--font-size--medium)"
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--accent)",
            "text": "var(--wp--preset--color--surface)"
          }
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontWeight": "600"
        }
      },
      "core/post-excerpt": {
        "color": {
          "text": "var(--wp--preset--color--texte-doux)"
        }
      },
      "core/post-date": {
        "color": {
          "text": "var(--wp--preset--color--texte-doux)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "En-tête",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Pied de page",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-sans-titre",
      "title": "Pleine page (sans titre)",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-portfolio",
      "title": "Portfolio",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-categorie",
      "title": "Catégorie du portfolio",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-projet",
      "title": "Projet",
      "postTypes": [
        "page"
      ]
    }
  ]
}