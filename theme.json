{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "760px", "wideSize": "1232px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "fond", "name": "Fond", "color": "#EEF1F6" },
        { "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
        { "slug": "encre", "name": "Encre", "color": "#12141C" },
        { "slug": "texte-doux", "name": "Texte doux", "color": "#4A4F5E" },
        { "slug": "accent", "name": "Accent", "color": "#5B3DF5" },
        { "slug": "citron", "name": "Citron", "color": "#D6FF5C" },
        { "slug": "marketing", "name": "Marketing", "color": "#FFD9C9" },
        { "slug": "communication", "name": "Communication", "color": "#CFE3FF" },
        { "slug": "creation", "name": "Création graphique", "color": "#D9F2D0" },
        { "slug": "gestion", "name": "Gestion de projet", "color": "#E6DDFF" },
        { "slug": "universitaire", "name": "Travaux universitaires", "color": "#FFF1C2" }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--fond)", "text": "var(--wp--preset--color--encre)" },
    "typography": { "fontFamily": "system-ui, sans-serif", "lineHeight": "1.55" }
  }
}
